PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamlink_ats
# Set to true for Neon / Render / Supabase / any managed Postgres (required by Render).
DATABASE_SSL=false
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h
CORS_ORIGIN=https://ats.tmlink.cloud
NODE_ENV=production
